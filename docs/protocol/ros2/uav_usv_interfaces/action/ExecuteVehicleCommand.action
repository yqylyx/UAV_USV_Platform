# Goal
string command_id
string client_request_id
string mission_id
string run_id
string device_code
string command
uint8 PRIORITY_AUTONOMOUS_HOLD=1
uint8 PRIORITY_MISSION=2
uint8 PRIORITY_MANUAL=3
uint8 PRIORITY_EMERGENCY=4
uint8 priority
builtin_interfaces/Time issued_at
builtin_interfaces/Time deadline_at
geometry_msgs/Point target_position_enu_m
float64 target_heading_deg
float64 target_altitude_m
float64 target_speed_mps
diagnostic_msgs/KeyValue[] extensions
---
# Result
uint8 STATUS_SUCCEEDED=6
uint8 STATUS_REJECTED=7
uint8 STATUS_FAILED=8
uint8 STATUS_CANCELLED=9
uint8 STATUS_TIMEOUT=10
uint8 STATUS_EXPIRED=11
uint8 status
string code
string message
builtin_interfaces/Time started_at
builtin_interfaces/Time completed_at
---
# Feedback
uint8 STATUS_ACCEPTED=4
uint8 STATUS_EXECUTING=5
uint8 status
float32 progress
string phase
string message
builtin_interfaces/Time source_timestamp
